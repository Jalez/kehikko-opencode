{
  "name": "kehikko-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example, a module a Kehikot host frames. An app: its own store, its own page, its own port.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "stub": "bun run dev/stub-host.ts",
